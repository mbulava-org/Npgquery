<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
	<TargetFrameworks>net10.0;net8.0;netstandard2.1</TargetFrameworks>
	<LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <IsPackable>false</IsPackable>
	  <IsShipping>false</IsShipping>
  </PropertyGroup>

  <!-- netstandard2.1 cannot produce an executable; override OutputType -->
  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.1'">
    <OutputType>Library</OutputType>
    <!-- Avoid trying to create an apphost for a library target -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Npgquery\Npgquery.csproj" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net6.0' or '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="pg_query.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>